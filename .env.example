# --- App & Server ---
APP_ENV=development
PORT=8080
PROXY_PORT=8080
WEB_PORT=3000
MOCK_PAY_PORT=9000
ORDER_TTL_SECONDS=900

# --- Database & Cache ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=inblack_topup_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:changeme_postgres_password@postgres:5432/inblack_topup_db?sslmode=disable

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Mail (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Security & Webhooks ---
JWT_SECRET=change_this_jwt_secret_key_for_local_dev_2026
PAYMENT_WEBHOOK_SECRET=whsec_change_this_webhook_secret_key_2026

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_MOCK_PAY_URL=http://localhost:9000
INTERNAL_API_URL=http://localhost:8080

# --- Mock Game Server ---
MOCK_GAME_PORT=9001
MOCK_GAME_URL=http://mock-game:9001
FAIL_RATE=0
TIMEOUT_RATE=0
SUCCESS_BUT_TIMEOUT_RATE=0
LATENCY_MS=0